{
  "name": "cdtn1-l2-se",
  "version": "1.0.0",
  "description": "L2 - Tiep nhan va phan loai yeu cau bao hanh (Track SE)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node tests/smoke-test.js && node tests/ticket.service.test.js",
    "db:up": "node scripts/db.js up",
    "db:down": "node scripts/db.js down",
    "db:reset": "node scripts/db.js reset",
    "migrate": "node scripts/run-sql.js migrations/001_create_core.sql migrations/002_add_request_id.sql migrations/003_add_catalog.sql",
    "seed": "node scripts/seed-catalog.js && node scripts/run-sql.js seeds/001_seed_demo.sql",
    "setup": "npm run db:up && node scripts/cho-db.js && npm run migrate && npm run seed",
    "demo": "node scripts/demo.js"
  },
  "keywords": [
    "cdtn1",
    "smart-crm",
    "mekong-mobile",
    "se",
    "postgresql"
  ],
  "author": "Nguyen Nam Khanh",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.16.3"
  }
}
